# ── LLM (OpenAI-compatible; DeepSeek is the cheapest capable default) ────────
# DeepSeek:  https://platform.deepseek.com  → API Keys
#   LLM_BASE_URL=https://api.deepseek.com   LLM_MODEL=deepseek-chat
# Qwen:      https://dashscope.aliyuncs.com
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-flash
# Zhipu:     https://open.bigmodel.cn
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4   LLM_MODEL=glm-4-flash  (free tier)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── TTS (free Microsoft Edge neural voices via msedge-tts, no key needed) ────
TTS_VOICE=zh-CN-XiaoxiaoNeural

# ── Database (used by the platform health check) ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
